<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:IphoneDuo_PoC"
             x:Class="IphoneDuo_PoC.ItemsPage"
             x:DataType="local:ItemsPage"
             Title="Items">
    <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
        <CollectionView.Header>
            <VerticalStackLayout Padding="24,20,24,12" Spacing="6">
                <Label Text="Items" Style="{StaticResource Headline}" />
                <Label Text="50 sample items" TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:ItemEntry">
                <Border Margin="16,6"
                        Padding="14"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Text="{Binding Title}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />
                        <Label Grid.Row="1"
                               Text="{Binding Description}"
                               TextColor="{StaticResource Gray600}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>