<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IphoneDuo_PoC.SettingsPage"
             Title="Settings">
    <Grid Padding="24">
        <VerticalStackLayout Spacing="8" VerticalOptions="Start">
            <Label Text="App information" Style="{StaticResource Headline}" />
            <Label Text="IphoneDuo-PoC" />
            <Label Text="Version 1.0" TextColor="{StaticResource Gray600}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>